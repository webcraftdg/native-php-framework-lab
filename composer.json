{
    "name": "webcraftdg/native-php-framework-lab",
    "description": "Natif projet for learning",
    "type": "library",
    "keywords": [
        "php",
        "mysql",
        "mariadb",
        "natif",
        "expérimentation",
        "laboratoire"
    ],
    "license": "MIT",
    "homepage": "https://github.com/webcraftdg/native-php-framework-lab",
    "support": {
        "issues": "https://github.com/webcraftdg/native-php-framework-lab/issues",
        "source": "https://github.com/webcraftdg/native-php-framework-lab"
    },
    "authors": [
        {
            "name": "David Ghyse"
        }
    ],
    "require": {
        "php": ">=8.3",
        "ext-dom": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-gd": "*",
        "ext-fileinfo": "*",
        "vlucas/phpdotenv": "~5.0"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "contacts\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
        }
    },
    "suggest": {
        "psr/log": "Allows integration with a PSR-3 compatible logger."
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}